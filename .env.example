REVIX_HOST=localhost
REVIX_SCHEME=http
REVIX_PORT=4000
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres
SECRET_KEY_BASE=                        # generate with: mix phx.gen.secret
CLOAK_KEY=                              # generate with: elixir -e "IO.puts(32 |> :crypto.strong_rand_bytes() |> Base.encode64())"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=                          # media uploads (avatars, images)
AWS_S3_DUMP_BUCKET=                     # database dump backups
