{
  "[elixir]": {
    "editor.defaultFormatter": "JakeBecker.elixir-ls"
  },
  "[phoenix-heex]": {
    "editor.defaultFormatter": "JakeBecker.elixir-ls",
    "editor.defaultFoldingRangeProvider": "vscode.html-language-features"
  },
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "emmet.includeLanguages": {
    "elixir": "html",
    "phoenix-heex": "html",
    "html-eex": "html"
  },
  "files.associations": {
    "*.heex": "phoenix-heex"
  }
}