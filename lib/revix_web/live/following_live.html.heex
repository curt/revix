<Layouts.app flash={@flash} current_scope={@current_scope} site={@site}>
  <div class="mx-auto max-w-7xl">
    <.header>Following</.header>

    <div class="mt-6 mb-8">
      <form id="follow-form" phx-submit="follow" phx-change="update_target" class="flex gap-3">
        <div class="flex-1">
          <.input
            type="text"
            name="target_uri"
            value={@target_uri}
            label="Follow someone (Actor URI)"
            placeholder="https://example.com/users/alice"
          />
        </div>
        <div class="flex items-end pb-1">
          <.button type="submit" phx-disable-with="Following…">Follow</.button>
        </div>
      </form>
    </div>

    <div class="tabs tabs-bordered mb-6">
      <button
        class={["tab", @tab == :following && "tab-active"]}
        phx-click="switch_tab"
        phx-value-tab="following"
      >
        Following ({length(@following)})
      </button>
      <button
        class={["tab", @tab == :followers && "tab-active"]}
        phx-click="switch_tab"
        phx-value-tab="followers"
      >
        Followers ({length(@followers) + length(@pending_followers)})
      </button>
    </div>

    <%= if @tab == :following do %>
      <%= if @following == [] do %>
        <div class="rounded-xl border border-dashed border-base-300 bg-base-200/40 p-8 text-center text-base-content/70">
          Not following anyone yet.
        </div>
      <% else %>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <%= for follow <- @following do %>
            <article class="flex h-full flex-col rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
              <div class="mb-4 text-xs font-semibold uppercase tracking-wide text-base-content/70">
                Following
              </div>
              <div class="grow text-sm text-base-content">
                <.person_link
                  person={Map.get(@people, follow.following_uri)}
                  uri={follow.following_uri}
                />
              </div>
              <button
                class="btn btn-sm btn-ghost mt-4 self-start"
                phx-click="unfollow"
                phx-value-following_uri={follow.following_uri}
              >
                Unfollow
              </button>
            </article>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%= if @tab == :followers do %>
      <div class="space-y-6">
        <%= if @pending_followers != [] do %>
          <section>
            <h3 class="mb-3 text-sm font-medium text-base-content/70">Pending</h3>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              <%= for follow <- @pending_followers do %>
                <article class="flex h-full flex-col rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                  <div class="mb-4 text-xs font-semibold uppercase tracking-wide text-base-content/70">
                    Follow Request
                  </div>
                  <div class="grow text-sm text-base-content">
                    <.person_link
                      person={Map.get(@people, follow.follower_uri)}
                      uri={follow.follower_uri}
                    />
                  </div>
                  <button
                    class="btn btn-sm btn-primary mt-4 self-start"
                    phx-click="accept"
                    phx-value-follow_id={follow.id}
                  >
                    Accept
                  </button>
                </article>
              <% end %>
            </div>
          </section>
        <% end %>

        <%= if @followers != [] do %>
          <section>
            <h3 class="mb-3 text-sm font-medium text-base-content/70">Accepted</h3>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              <%= for follow <- @followers do %>
                <article class="flex h-full flex-col rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                  <div class="mb-4 text-xs font-semibold uppercase tracking-wide text-base-content/70">
                    Follower
                  </div>
                  <div class="grow text-sm text-base-content">
                    <.person_link
                      person={Map.get(@people, follow.follower_uri)}
                      uri={follow.follower_uri}
                    />
                  </div>
                </article>
              <% end %>
            </div>
          </section>
        <% end %>

        <%= if @followers == [] and @pending_followers == [] do %>
          <div class="rounded-xl border border-dashed border-base-300 bg-base-200/40 p-8 text-center text-base-content/70">
            No followers yet.
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</Layouts.app>
