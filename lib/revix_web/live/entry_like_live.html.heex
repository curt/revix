<div class="inline-flex items-center gap-2 align-top" phx-hook="Timezone" id="entry-like-section">
  <%= if @current_scope do %>
    <button
      class="btn btn-soft p-2"
      phx-click={if @liked, do: "unlike", else: "like"}
      disabled={not @can_like}
      aria-label={if @liked, do: "Unlike", else: "Like"}
    >
      {if @liked, do: "Unlike", else: "Like"}
      <.icon
        name={if @liked, do: "hero-heart-solid", else: "hero-heart"}
        class={["w-6 h-6", if(@liked, do: "text-error", else: "text-current")]}
      />
    </button>
  <% end %>
  <%= if is_nil(@current_scope) do %>
    <.icon_link href="/people/signin" icon="hero-heart" icon_class="w-6 h-6 text-current">
      Like
    </.icon_link>
  <% end %>
  <%= if @likes != [] do %>
    <div class="flex -space-x-2">
      <%= for like <- Enum.take(@likes, 5), like.author do %>
        <.activity_avatar author={like.author} width={6} />
      <% end %>
      <%= if length(@likes) > 5 do %>
        <span class="text-sm ml-1">+{length(@likes) - 5} more</span>
      <% end %>
    </div>
  <% end %>
</div>
