<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-7xl">
    <.header>ActivityPub Pings</.header>

    <div class="mt-6 mb-8">
      <form
        id="send-ping-form"
        phx-submit="send_ping"
        phx-change="update_target"
        class="flex gap-3"
      >
        <div class="flex-1">
          <.input
            type="text"
            name="target_uri"
            value={@target_uri}
            label="Target Actor URI"
            placeholder="https://example.com/users/alice"
          />
        </div>
        <div class="flex items-end pb-1">
          <.button type="submit" phx-disable-with="Sending…">Send Ping</.button>
        </div>
      </form>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <%= for ping <- @pings do %>
        <article class="flex h-full flex-col rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          <div class="mb-3 flex items-center justify-between gap-3">
            <div class="text-xs font-semibold uppercase tracking-wide text-base-content/70">
              {ping.direction} · {ping.type}
            </div>
            <div class="text-xs text-base-content/70">{format_age(ping)}</div>
          </div>

          <dl class="grow space-y-3 text-sm">
            <div>
              <dt class="mb-1 text-xs font-medium uppercase tracking-wide text-base-content/70">
                Actor
              </dt>
              <dd class="text-base-content">
                <.person_link person={Map.get(@people, ping.actor_uri)} uri={ping.actor_uri} />
              </dd>
            </div>

            <div>
              <dt class="mb-1 text-xs font-medium uppercase tracking-wide text-base-content/70">
                Target
              </dt>
              <dd class="text-base-content">
                <.person_link person={Map.get(@people, ping.target_uri)} uri={ping.target_uri} />
              </dd>
            </div>

            <div>
              <dt class="mb-1 text-xs font-medium uppercase tracking-wide text-base-content/70">
                Status
              </dt>
              <dd class={"font-medium capitalize #{status_class(ping.status)}"}>
                {ping.status}
              </dd>
              <%= if ping.error do %>
                <p class="mt-1 text-xs text-base-content/60">{ping.error}</p>
              <% end %>
            </div>
          </dl>
        </article>
      <% end %>
    </div>

    <%= if @pings == [] do %>
      <div class="rounded-xl border border-dashed border-base-300 bg-base-200/40 p-8 text-center text-base-content/70">
        No pings yet.
      </div>
    <% end %>
  </div>
</Layouts.app>
