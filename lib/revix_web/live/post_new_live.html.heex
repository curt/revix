<Layouts.app flash={@flash} current_scope={@current_scope} site={@site}>
  <div class="mx-auto max-w-xl">
    <.header>
      New Post
    </.header>

    <.form
      for={@post_form}
      as={:post}
      id="post-form"
      phx-change="validate"
      phx-debounce="300"
      phx-submit="submit"
    >
      <div class="space-y-6" id="post-new-hook" phx-hook="Timezone">
        <div>
          <h2 class="text-lg font-semibold mb-3">Post Details</h2>

          <.input
            field={@post_form[:name]}
            type="text"
            label="Title (optional)"
          />

          <.input
            field={@post_form[:content]}
            type="textarea"
            label="Content"
            rows="6"
          />

          <.input
            field={@post_form[:published_tz]}
            type="select"
            label="Time Zone"
            options={@timezones}
          />
        </div>

        <%!-- Place Section --%>
        <div>
          <h2 class="text-lg font-semibold mb-3">Places (optional)</h2>
          <div class="flex flex-wrap gap-2 mb-2">
            <%= for place <- @selected_places do %>
              <div class="flex items-center gap-1 px-2 py-1 bg-base-200 rounded-full text-sm">
                <span>{place.name}</span>
                <button
                  type="button"
                  phx-click="remove_place"
                  phx-value-uri={place.uri}
                  class="btn btn-xs btn-circle btn-ghost"
                  aria-label={"Remove #{place.name}"}
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </div>
            <% end %>
          </div>
          <input
            type="text"
            name="place_query"
            value={@place_query}
            placeholder="Search places…"
            phx-change="search_places"
            phx-debounce="300"
            autocomplete="off"
            class="input input-bordered w-full"
          />
          <%= if @place_results != [] do %>
            <ul class="menu bg-base-200 rounded-box mt-1 w-full z-10">
              <%= for place <- @place_results do %>
                <li>
                  <button type="button" phx-click="add_place" phx-value-uri={place.uri}>
                    {place.name}
                  </button>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>

        <%!-- Companions Section --%>
        <RevixWeb.CompanionsComponent.companions_section
          companions={@companions}
          companion_query={@companion_query}
          companion_results={@companion_results}
        />

        <%!-- Photos Section --%>
        <RevixWeb.PhotosComponent.photos_section
          uploads={@uploads.images}
          upload_captions={@upload_captions}
          container_id="upload-entries-new"
        />

        <div class="flex gap-3">
          <button type="submit" name="action" value="draft" class="btn btn-secondary flex-1">
            Save as Draft
          </button>
          <button type="submit" name="action" value="publish" class="btn btn-warning flex-1">
            Publish…
          </button>
        </div>
      </div>
    </.form>

    <dialog :if={@show_publish_modal} class="modal" open>
      <div class="modal-box">
        <h3 class="font-bold text-lg">Publish this post?</h3>
        <p class="py-4">Once published, this cannot be undone.</p>
        <div class="modal-action">
          <button type="button" class="btn" phx-click="cancel_publish">Cancel</button>
          <button type="button" class="btn btn-warning" phx-click="confirm_publish">
            Publish
          </button>
        </div>
      </div>
      <div class="modal-backdrop" phx-click="cancel_publish"></div>
    </dialog>
  </div>
</Layouts.app>
