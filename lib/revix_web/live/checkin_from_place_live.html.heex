<Layouts.app flash={@flash} current_scope={@current_scope} site={@site}>
  <div class="mx-auto max-w-xl">
    <.header>
      New Checkin at {@place.name}
    </.header>

    <.form
      for={@checkin_form}
      as={:checkin}
      id="checkin-form"
      phx-hook="PlaceSearch"
      phx-change="validate"
      phx-debounce="300"
      phx-submit="submit"
    >
      <div class="space-y-6">
        <%!-- Checkin Details Section --%>
        <div>
          <h2 class="text-lg font-semibold mb-3">Checkin Details</h2>

          <.input
            field={@checkin_form[:content]}
            type="textarea"
            label="Content"
            rows="4"
          />

          <.input
            field={@checkin_form[:starts_at_local]}
            type="datetime-local"
            label="Date and Time"
          />

          <.input
            field={@checkin_form[:starts_tz]}
            type="select"
            label="Time Zone"
            options={@timezones}
          />
        </div>

        <%!-- Companions Section --%>
        <RevixWeb.CompanionsComponent.companions_section
          companions={@companions}
          companion_query={@companion_query}
          companion_results={@companion_results}
        />

        <%!-- Photos Section --%>
        <RevixWeb.PhotosComponent.photos_section
          uploads={@uploads.images}
          upload_captions={@upload_captions}
          container_id="upload-entries-new-from-place"
        />

        <div class="flex gap-2">
          <button type="submit" name="action" value="draft" class="btn btn-secondary flex-1">
            Save as Draft
          </button>
          <button type="submit" name="action" value="view" class="btn btn-ghost flex-1">
            View
          </button>
          <button type="submit" name="action" value="publish" class="btn btn-primary flex-1">
            Publish…
          </button>
        </div>
      </div>
    </.form>

    <%!-- Publish confirmation modal --%>
    <.confirm_dialog
      id="publish-checkin-modal"
      show={@show_publish_modal}
      title="Publish this checkin?"
      on_cancel="cancel_publish"
      on_confirm="confirm_publish"
      confirm_label="Publish"
      confirm_class="btn-primary"
    >
      <p class="py-4">
        Publishing shares this with your followers. You can edit or delete it later, but you can't return it to draft.
      </p>
    </.confirm_dialog>
  </div>
</Layouts.app>
