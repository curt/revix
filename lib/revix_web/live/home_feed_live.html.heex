<Layouts.app flash={@flash} current_scope={@current_scope} site={@site}>
  <div class="mx-auto max-w-7xl">
    <h1 class="my-4 leading-10">{@site.title}</h1>
    <div :if={@description_html} class="content">{raw(@description_html)}</div>
    <.map />
    <.activity_feed activities={@activities} has_more={@has_more} />
  </div>
</Layouts.app>
