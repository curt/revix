<div id="comment-section-container" phx-hook="Timezone">
  <%= if @current_scope do %>
    <div class="my-4">
      <%= if @comment_tree != [] do %>
        <%= for comment <- @comment_tree do %>
          <div
            id={"comment-#{comment.id}"}
            class={[
              "chat mb-3",
              if(@current_scope && @current_scope.person.uri == comment.author_uri,
                do: "chat-end",
                else: "chat-start"
              )
            ]}
          >
            <div class="chat-image">
              <.comment_avatar author={comment.author} author_uri={comment.author_uri} width={8} />
            </div>
            <.comment_row
              comment={comment}
              current_scope={@current_scope}
              liked_uris={@liked_uris}
              like_counts={@like_counts}
              liker_map={@liker_map}
              editing_id={@editing_id}
              comment_max_length={@comment_max_length}
            />
          </div>
          <%= if @reply_to_id == comment.id do %>
            <.reply_form comment_id={comment.id} comment_max_length={@comment_max_length} />
          <% end %>
        <% end %>
      <% end %>
      <form id="comment-form" class="my-4" phx-change="validate" phx-submit="submit_comment">
        <textarea
          name="content"
          class="textarea textarea-bordered w-full"
          placeholder="Add a comment..."
          rows="3"
          {if @comment_max_length, do: [maxlength: @comment_max_length], else: []}
        >{@new_comment_content}</textarea>
        <%= if @can_upload_images do %>
          <div class="mt-2">
            <.live_file_input
              upload={@uploads.images}
              class="file-input file-input-bordered file-input-sm w-full"
            />
            <%= for entry <- @uploads.images.entries do %>
              <div id={"upload-entry-#{entry.ref}"} class="flex items-center gap-2 mt-1">
                <.live_img_preview entry={entry} class="w-10 h-10 rounded object-cover" />
                <span class="text-sm truncate grow">{entry.client_name}</span>
                <progress value={entry.progress} max="100" class="progress progress-primary w-24" />
                <button
                  type="button"
                  phx-click="cancel_upload"
                  phx-value-ref={entry.ref}
                  class="btn btn-ghost btn-xs text-error"
                  aria-label="Cancel upload"
                >
                  &times;
                </button>
              </div>
              <%= for err <- upload_errors(@uploads.images, entry) do %>
                <p class="text-error text-xs">
                  {entry.client_name}: {upload_error_to_string(err)}
                </p>
              <% end %>
            <% end %>
            <%= for err <- upload_errors(@uploads.images) do %>
              <p class="text-error text-xs mt-1">{upload_error_to_string(err)}</p>
            <% end %>
          </div>
        <% end %>
        <div class="flex justify-end mt-1">
          <button
            type="submit"
            class="btn btn-primary btn-sm"
            disabled={
              not comment_submittable?(
                @new_comment_content,
                @can_upload_images,
                assigns[:uploads]
              )
            }
          >
            Comment
          </button>
        </div>
      </form>
    </div>
  <% else %>
    <div class="inline-flex items-center gap-3 align-top">
      <.icon_link href="/people/signin" icon="hero-chat-bubble-left">
        Comment
      </.icon_link>
      <%= if @comment_tree != [] do %>
        <div class="flex -space-x-2">
          <%= for author <- unique_comment_authors(@comment_tree) |> Enum.take(8) do %>
            <.activity_avatar author={author} width={6} />
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
