<Layouts.app flash={@flash} current_scope={@current_scope} site={@site}>
  <div class="mx-auto max-w-xl">
    <.header>
      Edit Checkin
    </.header>

    <div class="my-4">
      <p class="text-sm text-base-content/70">
        <strong>{@checkin.place.name}</strong>
        <span :if={not @can_edit_datetime}>
          &mdash; {Calendar.strftime(@checkin.starts_at_local, "%Y-%m-%d")}
          {format_local_datetime(
            @checkin.starts_at_local,
            @checkin.starts_tz,
            @checkin.starts_at_utc
          )}
        </span>
      </p>
    </div>

    <.form
      for={@form}
      as={:checkin}
      id="edit-checkin-form"
      phx-change="validate"
      phx-debounce="300"
      phx-submit="submit"
    >
      <div class="space-y-6">
        <div :if={@can_edit_datetime}>
          <h2 class="text-lg font-semibold mb-3">Date and Time</h2>
          <.input
            field={@form[:starts_at_local]}
            type="datetime-local"
            label="Date and Time"
          />
          <.input
            field={@form[:starts_tz]}
            type="select"
            label="Time Zone"
            options={@timezones}
          />
        </div>

        <div>
          <h2 class="text-lg font-semibold mb-3">Content</h2>
          <.input
            field={@form[:content]}
            type="textarea"
            label="Content"
            rows="4"
          />
        </div>

        <%!-- Photos Section --%>
        <RevixWeb.PhotosComponent.photos_section
          uploads={@uploads.images}
          upload_captions={@upload_captions}
          container_id="upload-entries-edit"
          existing_images={@checkin.entry_images}
          image_captions={@image_captions}
          pending_remove_image_id={@pending_remove_image_id}
        />

        <RevixWeb.CompanionsComponent.companions_section
          companions={@companions}
          companion_query={@companion_query}
          companion_results={@companion_results}
          saves_immediately
        />

        <div :if={not @checkin_published} class="flex gap-2">
          <button type="submit" name="action" value="draft" class="btn btn-secondary flex-1">
            Save as Draft
          </button>
          <button type="submit" name="action" value="view" class="btn btn-ghost flex-1">
            View
          </button>
          <button type="submit" name="action" value="publish" class="btn btn-primary flex-1">
            Publish…
          </button>
        </div>
        <div :if={@checkin_published} class="flex gap-2">
          <.button type="submit" class="btn btn-primary flex-1">
            Save Changes
          </.button>
          <button
            type="button"
            id="view-entry"
            class="btn btn-ghost"
            phx-click="view"
            disabled={@pending_edits}
            title={@pending_edits && "Save your changes first"}
          >
            View
          </button>
        </div>

        <button
          type="button"
          class="btn btn-ghost btn-sm text-error w-full mt-1"
          phx-click="request_delete"
        >
          Delete checkin…
        </button>
      </div>
    </.form>

    <%!-- Publish confirmation modal --%>
    <.confirm_dialog
      id="publish-checkin-modal"
      show={@show_publish_modal}
      title="Publish this checkin?"
      on_cancel="cancel_publish"
      on_confirm="confirm_publish"
      confirm_label="Publish"
      confirm_class="btn-primary"
    >
      <p class="py-4">
        Publishing shares this with your followers. You can edit or delete it later, but you can't return it to draft.
      </p>
    </.confirm_dialog>

    <%!-- Delete confirmation modal --%>
    <.confirm_dialog
      id="delete-checkin-modal"
      show={@pending_delete}
      title="Delete this checkin?"
      on_cancel="cancel_delete"
      on_confirm="confirm_delete"
      confirm_label="Delete"
      confirm_class="btn-error"
    >
      <p :if={@checkin_published} class="py-4">
        This will remove the checkin from public view and notify your followers. This cannot be undone.
      </p>
      <p :if={not @checkin_published} class="py-4">
        This will permanently delete the checkin and all its photos. This cannot be undone.
      </p>
    </.confirm_dialog>
  </div>
</Layouts.app>
