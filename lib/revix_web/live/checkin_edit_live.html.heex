<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-xl">
    <.header>
      Edit Checkin
    </.header>

    <div class="my-4">
      <p class="text-sm text-base-content/70">
        <strong>{@checkin.place.name}</strong>
        <span :if={not @can_edit_datetime}>
          &mdash; {Calendar.strftime(@checkin.starts_at_local, "%Y-%m-%d")}
          {format_local_datetime(
            @checkin.starts_at_local,
            @checkin.starts_tz,
            @checkin.starts_at_utc
          )}
        </span>
      </p>
    </div>

    <.form
      for={@form}
      as={:checkin}
      id="edit-checkin-form"
      phx-change="validate"
      phx-debounce="300"
      phx-submit="submit"
    >
      <div class="space-y-6">
        <div :if={@can_edit_datetime}>
          <h2 class="text-lg font-semibold mb-3">Date and Time</h2>
          <.input
            field={@form[:starts_at_local]}
            type="datetime-local"
            label="Date and Time"
          />
          <.input
            field={@form[:starts_tz]}
            type="select"
            label="Time Zone"
            options={@timezones}
          />
        </div>

        <div>
          <h2 class="text-lg font-semibold mb-3">Content</h2>
          <.input
            field={@form[:content]}
            type="textarea"
            label="Content"
            rows="4"
          />
        </div>

        <%!-- Photos Section --%>
        <RevixWeb.PhotosComponent.photos_section
          uploads={@uploads.images}
          upload_captions={@upload_captions}
          container_id="upload-entries-edit"
          existing_images={@checkin.entry_images}
          image_captions={@image_captions}
          pending_remove_image_id={@pending_remove_image_id}
        />

        <RevixWeb.CompanionsComponent.companions_section
          companions={@companions}
          companion_query={@companion_query}
          companion_results={@companion_results}
        />

        <div :if={not @checkin_published} class="flex gap-2">
          <button type="submit" name="action" value="draft" class="btn btn-secondary flex-1">
            Save as Draft
          </button>
          <button type="submit" name="action" value="publish" class="btn btn-primary flex-1">
            Publish…
          </button>
        </div>
        <.button :if={@checkin_published} type="submit" class="btn btn-primary w-full">
          Save Changes
        </.button>

        <button
          :if={not @checkin_published}
          type="button"
          class="btn btn-ghost btn-sm text-error w-full mt-1"
          phx-click="request_delete"
        >
          Delete checkin…
        </button>
      </div>
    </.form>

    <%!-- Publish confirmation modal --%>
    <dialog :if={@show_publish_modal} id="publish-checkin-modal" class="modal" open>
      <div class="modal-box">
        <h3 class="font-bold text-lg">Publish this checkin?</h3>
        <p class="py-4">Once published, this cannot be undone.</p>
        <div class="modal-action">
          <button type="button" class="btn" phx-click="cancel_publish">Cancel</button>
          <button type="button" class="btn btn-primary" phx-click="confirm_publish">
            Publish
          </button>
        </div>
      </div>
      <div class="modal-backdrop" phx-click="cancel_publish"></div>
    </dialog>

    <%!-- Delete confirmation modal --%>
    <dialog :if={@pending_delete} id="delete-checkin-modal" class="modal" open>
      <div class="modal-box">
        <h3 class="font-bold text-lg">Delete this checkin?</h3>
        <p class="py-4">
          This will permanently delete the checkin and all its photos. This cannot be undone.
        </p>
        <div class="modal-action">
          <button type="button" class="btn" phx-click="cancel_delete">Cancel</button>
          <button type="button" class="btn btn-error" phx-click="confirm_delete">
            Delete
          </button>
        </div>
      </div>
      <div class="modal-backdrop" phx-click="cancel_delete"></div>
    </dialog>
  </div>
</Layouts.app>
