<Layouts.app flash={@flash} current_scope={@current_scope} site={@site}>
  <div class="mx-auto max-w-sm">
    <div class="text-center">
      <.header>Welcome {@person.email}</.header>
    </div>

    <.form
      :if={!@person.confirmed_at}
      for={@form}
      id="confirmation_form"
      action={~p"/people/signin?_action=confirmed"}
      phx-mounted={JS.focus_first()}
    >
      <input type="hidden" name={@form[:token].name} value={@form[:token].value} />
      <.button
        name={@form[:remember_me].name}
        value="true"
        phx-disable-with="Confirming..."
        class="btn btn-primary w-full"
      >
        Confirm and stay logged in
      </.button>
      <.button phx-disable-with="Confirming..." class="btn btn-primary btn-soft w-full mt-2">
        Confirm and sign in only this time
      </.button>
    </.form>

    <.form
      :if={@person.confirmed_at}
      for={@form}
      id="login_form"
      action={~p"/people/signin"}
      phx-mounted={JS.focus_first()}
    >
      <input type="hidden" name={@form[:token].name} value={@form[:token].value} />
      <%= if @current_scope do %>
        <.button variant="primary" phx-disable-with="Logging in..." class="btn btn-primary w-full">
          Sign in
        </.button>
      <% else %>
        <.button
          name={@form[:remember_me].name}
          value="true"
          phx-disable-with="Logging in..."
          class="btn btn-primary w-full"
        >
          Keep me logged in on this device
        </.button>
        <.button phx-disable-with="Logging in..." class="btn btn-primary btn-soft w-full mt-2">
          Log me in only this time
        </.button>
      <% end %>
    </.form>

    <p :if={!@person.confirmed_at} class="alert alert-outline mt-8">
      Tip: If you prefer passwords, you can enable them in the person settings.
    </p>
  </div>
</Layouts.app>
