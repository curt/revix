<Layouts.app flash={@flash} current_scope={@current_scope} site={@site}>
  <div class="mx-auto max-w-7xl">
    <.header>
      Posts
      <:actions :if={@current_scope && @current_scope.person.role == :owner}>
        <.link href={~p"/posts/new"} class="btn btn-primary btn-sm">New Post</.link>
      </:actions>
    </.header>
    <.map />
    <.inline_list :let={post} title="Drafts" entries={@draft_posts}>
      <a href={post.url} class="inline-block py-1 -my-1 align-middle">
        {post.name || "Untitled Draft"}
        <span class="badge badge-warning badge-sm ml-1">Draft</span>
        <span class="text-base-content/60">
          Updated {Calendar.strftime(post.updated_at, "%Y-%m-%d")}
        </span>
      </a>
    </.inline_list>
    <.inline_list :let={post} entries={@posts}>
      <a href={post.url} class="inline-block py-1 -my-1">
        <.avatar_image
          :if={post.author}
          person={post.author}
          class="inline-block w-5 h-5 rounded-full align-middle mr-1"
        />{post.name || "Post"}
        <%= if post.published_at_local do %>
          <span class="text-base-content/60">
            {Calendar.strftime(post.published_at_local, "%Y-%m-%d")}
          </span>
        <% end %>
      </a>
      <span
        :if={(like_count = Map.get(@like_counts, post.uri, 0)) > 0}
        class="inline-flex items-center align-middle gap-0.5 text-base-content/60"
      >
        <.icon name="hero-heart" class="w-4 h-4" />{like_count}
      </span>
    </.inline_list>
  </div>
</Layouts.app>
