<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-7xl">
    <.header>
      Posts
      <:actions :if={@current_scope && @current_scope.person.role == :owner}>
        <.link href={~p"/posts/new"} class="btn btn-primary btn-sm">New Post</.link>
      </:actions>
    </.header>
    <.map />
    <%= if @draft_posts != [] do %>
      <h2 class="text-base font-semibold mt-4 mb-2 text-base-content/60">Drafts</h2>
      <.labeled_list :let={post} entries={@draft_posts}>
        <a href={post.url} class="m-1 inline-block align-middle">
          {post.name || "Untitled Draft"}
          <span class="badge badge-warning badge-sm ml-1">Draft</span>
          <br />
          <span class="text-sm italic">
            Updated {Calendar.strftime(post.updated_at, "%Y-%m-%d")}
          </span>
        </a>
      </.labeled_list>
    <% end %>
    <.labeled_list :let={post} entries={@posts}>
      <%= if post.author do %>
        <div class="avatar inline-block align-middle">
          <div class="w-8 rounded-full">
            <img
              src={Revix.Uploaders.Avatar.url({post.author.avatar, post.author}, :thumb)}
              alt={post.author.display_name || post.author.username || ""}
            />
          </div>
        </div>
      <% end %>
      <a href={post.url} class="m-1 inline-block align-middle">
        {post.name || "Post"}<br />
        <span class="text-sm italic">
          <%= if post.published_at_local do %>
            {Calendar.strftime(post.published_at_local, "%Y-%m-%d")}
          <% end %>
        </span>
      </a>
      <%= if (like_count = Map.get(@like_counts, post.uri, 0)) > 0 do %>
        <.icon name="hero-heart" class="w-4 h-4 inline-block align-middle" />
        <span class="text-sm text-base-content/60 inline-block align-middle">
          {like_count}
        </span>
      <% end %>
    </.labeled_list>
  </div>
</Layouts.app>
