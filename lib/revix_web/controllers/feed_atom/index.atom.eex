<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <id><%= @site_url <> "/feed.atom" %></id>
  <title>Revix Activity</title>
  <subtitle>Posts, check-ins, likes, and comments</subtitle>
  <link rel="self" type="application/atom+xml" href="<%= @feed_url %>"/>
  <link rel="alternate" type="text/html" href="<%= @site_url %>"/>
  <updated><%= format_atom_datetime(@updated_at) %></updated>
<%= for activity <- @activities do %>
  <entry>
    <id><%= feed_entry_id(activity) %></id>
    <title type="text"><%= Phoenix.HTML.html_escape(feed_entry_title(activity)) |> Phoenix.HTML.safe_to_string() %></title>
    <updated><%= feed_entry_updated(activity) %></updated>
    <author>
      <name><%= Phoenix.HTML.html_escape(feed_entry_author_name(activity)) |> Phoenix.HTML.safe_to_string() %></name>
      <%= if uri = feed_entry_author_uri(activity) do %><uri><%= uri %></uri><% end %>
    </author>
    <%= if link = feed_entry_link(activity) do %><link rel="alternate" type="text/html" href="<%= link %>"/><% end %>
    <%= if content = feed_entry_content(activity) do %><content type="html"><![CDATA[<%= content %>]]></content><% end %>
  </entry>
<% end %>
</feed>
