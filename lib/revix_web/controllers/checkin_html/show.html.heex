<Layouts.app flash={@flash} current_scope={@current_scope} site={@site}>
  <div class="mx-auto max-w-7xl h-entry">
    <link class="u-uid" href={@checkin.uri} />
    <article class="my-4">
      <h1 class="my-4 leading-10">
        <a class="p-location" href={@place.url}>{@place.name}</a>
      </h1>
      <.entry_owner_actions
        current_scope={@current_scope}
        entry_author_uri={@checkin.author_uri}
        has_images={@checkin.entry_images != []}
        edit_href={~p"/checkins/#{@checkin.id}/edit"}
        retransform_href={~p"/checkins/#{@checkin.id}/retransform_images"}
        entry_label="checkin"
      />
      <div class="my-4 flex items-start gap-2">
        <div class="shrink-0">
          <.activity_avatar author={@checkin.author} />
        </div>
        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-baseline gap-1 sm:gap-x-1">
          <span class="p-author h-card">
            <%= if @checkin.author.display_name do %>
              <a class="u-url p-name" href={@checkin.author.url}>
                {@checkin.author.display_name}
              </a>
              checked in
            <% else %>
              checked in
            <% end %>
          </span>
          <time class="dt-start" datetime={DateTime.to_iso8601(@checkin.starts_at_utc)}>
            {Calendar.strftime(@checkin.starts_at_local, "%Y-%m-%d")} {format_local_datetime(
              @checkin.starts_at_local,
              @checkin.starts_tz,
              @checkin.starts_at_utc
            )}
          </time>
          <%= if @companions != [] do %>
            <span id="companion-section">
              with
              <span class="inline-flex -space-x-2 align-middle">
                <%= for ep <- Enum.take(@companions, 5), ep.person do %>
                  <.activity_avatar author={ep.person} width={6} />
                <% end %>
                <%= if length(@companions) > 5 do %>
                  <span class="text-sm ml-1">+{length(@companions) - 5} more</span>
                <% end %>
              </span>
            </span>
          <% end %>
        </div>
      </div>
      <%= if @checkin.content_html do %>
        <div class="content e-content">
          {raw(@checkin.content_html)}
        </div>
      <% end %>
      <%= if @checkin.entry_images != [] do %>
        <%= for entry_image <- @checkin.entry_images do %>
          <figure class="my-4 mx-auto w-fit">
            <a href={
              Revix.Uploaders.Image.url({entry_image.image.file, entry_image.image}, :large)
            }>
              <img
                src={
                  Revix.Uploaders.Image.url(
                    {entry_image.image.file, entry_image.image},
                    :medium
                  )
                }
                alt={entry_image.image.alt || ""}
                class="rounded max-w-full h-auto max-h-[min(80vh,800px)] w-auto"
                loading="lazy"
                {dimension_attrs(entry_image.image, :medium)}
                {srcset_attrs(entry_image.image, "(max-width: 800px) 100vw, 800px")}
              />
            </a>
            <%= if entry_image.image.caption_html do %>
              <figcaption class="my-1 font-serif text-center text-base-content/80">
                {raw(entry_image.image.caption_html)}
              </figcaption>
            <% end %>
          </figure>
        <% end %>
      <% end %>
      <.entry_interactions
        conn={@conn}
        current_scope={@current_scope}
        entry_uri={@checkin.uri}
        entry_author_uri={@checkin.author_uri}
        person_token={@person_token}
      />
      <.map />
    </article>
    <%= if @checkins != [] do %>
      <div id="checkins">
        <.inline_list :let={checkin} title="Other Checkins" entries={@checkins}>
          <a href={checkin.url} class="inline-block py-1 -my-1">
            <.avatar_image
              :if={checkin.author}
              person={checkin.author}
              class="inline-block w-5 h-5 rounded-full align-middle mr-1"
            />{Calendar.strftime(checkin.starts_at_local, "%Y-%m-%d")}
            <span class="text-base-content/60">
              {format_local_datetime(
                checkin.starts_at_local,
                checkin.starts_tz,
                checkin.starts_at_utc
              )}
            </span>
          </a>
        </.inline_list>
      </div>
    <% end %>
    <%= if @nearby != [] do %>
      <div id="nearby">
        <.inline_list :let={nearby} title="Nearby Places" entries={@nearby}>
          <a href={nearby.place.url} class="inline-block py-1 -my-1">
            {nearby.place.name}
            <span class="text-base-content/60">
              {Float.round(nearby.distance / 1000, 1)} km
            </span>
          </a>
        </.inline_list>
      </div>
    <% end %>
  </div>
</Layouts.app>
