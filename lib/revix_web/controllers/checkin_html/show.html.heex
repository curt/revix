<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-7xl h-entry">
    <div class="my-4">
      <h1 class="my-4 leading-10">
        <a href={@place.url}>{@place.name}</a>
      </h1>
      <div class="my-2">
        <.activity_avatar author={@checkin.author} />
        <p class="m-1 inline-block align-middle">
          <%= if @checkin.author.display_name do %>
            <a href={@checkin.author.url}>{@checkin.author.display_name}</a> checked in
          <% else %>
            checked in
          <% end %>
          <span>
            {Calendar.strftime(@checkin.starts_at_local, "%Y-%m-%d")} {format_local_datetime(
              @checkin.starts_at_local,
              @checkin.starts_tz,
              @checkin.starts_at_utc
            )}
          </span>
          <%= if @companions != [] do %>
            with
            <div id="companion-section" class="m-1 inline-block align-middle">
              <div class="flex -space-x-2">
                <%= for ep <- Enum.take(@companions, 5), ep.person do %>
                  <.activity_avatar author={ep.person} width={6} />
                <% end %>
                <%= if length(@companions) > 5 do %>
                  <span class="text-sm ml-1">+{length(@companions) - 5} more</span>
                <% end %>
              </div>
            </div>
          <% end %>
          <%= if @current_scope && @current_scope.person.uri == @checkin.author_uri do %>
            <a
              href={~p"/checkins/#{@checkin.id}/edit"}
              class="my-1 inline-block align-middle"
            >
              <.icon name="hero-pencil-square" class="w-5 h-5" /> Edit
            </a>
          <% end %>
        </p>
      </div>
      <%= if @checkin.content_html do %>
        <div class="content e-content">
          {raw(@checkin.content_html)}
        </div>
      <% end %>
      <div
        id="like-section"
        class="my-2 flex items-center gap-2"
        data-object-uri={@checkin.uri}
        data-liked={to_string(@liked)}
      >
        <button
          id="like-btn"
          class="btn btn-soft p-2"
          disabled={not @can_like}
          aria-label={if @liked, do: "Unlike", else: "Like"}
        >
          Like
          <span id="like-icon">
            <.icon
              name={if @liked, do: "hero-heart-solid", else: "hero-heart"}
              class="w-6 h-6 text-error"
            />
          </span>
          <span id="like-spinner" hidden>
            <.icon name="hero-arrow-path" class="w-5 h-5 animate-spin" />
          </span>
        </button>
        <%= if @likes != [] do %>
          <div id="like-avatars" class="flex -space-x-2">
            <%= for like <- Enum.take(@likes, 5), like.author do %>
              <.activity_avatar author={like.author} width={6} />
            <% end %>
            <%= if length(@likes) > 5 do %>
              <span id="like-overflow" class="text-sm ml-1">+{length(@likes) - 5} more</span>
            <% end %>
          </div>
        <% else %>
          <div id="like-avatars" class="flex -space-x-2"></div>
        <% end %>
      </div>

      <%= if @checkin.entry_images != [] do %>
        <h2>Attachments</h2>
        <%= for entry_image <- @checkin.entry_images do %>
          <figure class="my-4">
            <a href={
              Revix.Uploaders.Image.url({entry_image.image.file, entry_image.image}, :original)
            }>
              <img
                src={
                  Revix.Uploaders.Image.url(
                    {entry_image.image.file, entry_image.image},
                    :medium
                  )
                }
                alt={entry_image.image.alt || ""}
                class="rounded"
                loading="lazy"
              />
            </a>
            <%= if entry_image.image.caption_html do %>
              <figcaption class="my-1 font-serif text text-base-content/80">
                {raw(entry_image.image.caption_html)}
              </figcaption>
            <% end %>
          </figure>
        <% end %>
      <% end %>
      <div id="comments-section" class="my-4">
        <%= if @comments != [] do %>
          <h2>Comments</h2>
          <%= for comment <- @comments do %>
            <div id={"comment-#{comment.id}"} class="my-4 pl-3 border-l-2 border-base-300">
              <div class="flex items-center gap-2 mb-1">
                <%= if comment.author do %>
                  <div class="avatar">
                    <div class="w-6 rounded-full">
                      <img src={
                        Revix.Uploaders.Avatar.url(
                          {comment.author.avatar, comment.author},
                          :thumb
                        )
                      } />
                    </div>
                  </div>
                  <span class="text-sm font-medium">
                    {comment.author.display_name || comment.author.username}
                  </span>
                <% end %>
                <span class="text-xs text-base-content/60">
                  {Calendar.strftime(comment.published_at_local, "%Y-%m-%d")} {format_local_datetime(
                    comment.published_at_local,
                    comment.published_tz,
                    comment.published_at_utc
                  )}
                </span>
                <%= if @current_scope && @current_scope.person.uri == comment.author_uri do %>
                  <div class="ml-auto flex gap-1">
                    <button
                      class="btn btn-ghost btn-xs"
                      data-edit-comment={comment.id}
                      aria-label="Edit comment"
                    >
                      <.icon name="hero-pencil-square" class="w-4 h-4" />
                    </button>
                    <button
                      class="btn btn-ghost btn-xs text-error"
                      data-delete-comment={comment.id}
                      aria-label="Delete comment"
                    >
                      <.icon name="hero-trash" class="w-4 h-4" />
                    </button>
                  </div>
                <% end %>
              </div>
              <div id={"comment-display-#{comment.id}"} class="my-2 font-serif text">
                {raw(comment.content_html)}
              </div>
              <%= if @current_scope && @current_scope.person.uri == comment.author_uri do %>
                <form
                  id={"comment-edit-form-#{comment.id}"}
                  class="hidden mt-1"
                  data-comment-id={comment.id}
                >
                  <textarea
                    name="note[content]"
                    class="textarea textarea-bordered w-full text-sm"
                    rows="3"
                    data-char-counter
                    {if @comment_max_length, do: [maxlength: @comment_max_length, "data-max": @comment_max_length], else: []}
                  >{comment.content}</textarea>
                  <div class="text-xs text-right text-base-content/60 -mt-1" data-char-count>
                  </div>
                  <div class="flex gap-2 mt-1">
                    <button type="submit" class="btn btn-primary btn-xs">Save</button>
                    <button
                      type="button"
                      class="btn btn-ghost btn-xs"
                      data-cancel-edit={comment.id}
                    >
                      Cancel
                    </button>
                  </div>
                </form>
              <% end %>
            </div>
          <% end %>
        <% end %>
        <%= if @current_scope do %>
          <form method="post" action={~p"/notes"} class="my-4">
            <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
            <input type="hidden" name="note[in_reply_to_uri]" value={@checkin.uri} />
            <input type="hidden" name="note[published_tz]" id="comment-tz" value="" />
            <textarea
              name="note[content]"
              class="textarea textarea-bordered w-full"
              placeholder="Add a comment..."
              rows="3"
              data-char-counter
              {if @comment_max_length,
                do: [maxlength: @comment_max_length, "data-max": @comment_max_length],
                else: []}
            ></textarea>
            <div class="text-xs text-right text-base-content/60 -mt-1" data-char-count></div>
            <div class="flex justify-end mt-1">
              <button type="submit" class="btn btn-primary btn-sm">Comment</button>
            </div>
          </form>
        <% end %>
      </div>
    </div>
    <h2>Map</h2>
    <div id="map"></div>
    <%= if @checkins != [] do %>
      <div id="checkins">
        <h2>Other Checkins</h2>
        <.labeled_list :let={checkin} entries={@checkins}>
          <%= if checkin.author do %>
            <div class="avatar inline-block align-middle">
              <div class="w-8 rounded-full">
                <img src={
                  Revix.Uploaders.Avatar.url({checkin.author.avatar, checkin.author}, :thumb)
                } />
              </div>
            </div>
          <% end %>
          <a href={checkin.url} class="m-1 inline-block align-middle">
            {Calendar.strftime(checkin.starts_at_local, "%Y-%m-%d")}<br />
            <span class="text-sm italic">
              {format_local_datetime(
                checkin.starts_at_local,
                checkin.starts_tz,
                checkin.starts_at_utc
              )}
            </span>
          </a>
        </.labeled_list>
      </div>
    <% end %>
    <%= if @nearby != [] do %>
      <div id="nearby">
        <h2>Nearby Places</h2>
        <.labeled_list :let={nearby} entries={@nearby}>
          <.icon name="hero-map-pin-solid" class="text-accent" />
          <a href={nearby.place.url} class="m-1 inline-block align-middle">
            {nearby.place.name}<br />
            <span class="text-sm italic">{Float.round(nearby.distance / 1000, 1)} km</span>
          </a>
        </.labeled_list>
      </div>
    <% end %>
  </div>
</Layouts.app>
